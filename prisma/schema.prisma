generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────

enum AuthProvider {
  LOCAL
  GOOGLE
  GITHUB
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
  DELETED
}

enum EmailStatus {
  UNVERIFIED
  VERIFIED
  BLOCKED
}

enum AppearanceType {
  COLOR
  IMAGE
}

enum AuthTokenType {
  PASSWORD_RESET
  EMAIL_VERIFICATION
}

// ─────────────────────────────────────────────────────────────
// User
// ─────────────────────────────────────────────────────────────

model User {
  id        String @id @default(uuid()) @db.Uuid
  firstName String @db.VarChar(100)
  lastName  String @db.VarChar(100)

  // Always store lowercase + trimmed (normalize in the app, enforced by CHECK below)
  email String @unique @db.VarChar(255)

  role        UserRole    @default(USER)
  status      UserStatus  @default(ACTIVE)
  emailStatus EmailStatus @default(UNVERIFIED)

  emailVerifiedAt   DateTime?
  passwordChangedAt DateTime? // revoke sessions/tokens issued before this
  deletedAt         DateTime? // set when status = DELETED (soft delete)

  loginCount    Int       @default(0)
  loginAttempts Int       @default(0)
  lockoutUntil  DateTime?
  lastLoginAt   DateTime?

  accounts           Account[]
  refreshTokens      RefreshToken[]
  authTokens         AuthToken[]
  emailChangeRequest EmailChangeRequest?

  profile  UserProfile?
  settings UserSettings?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

// ─────────────────────────────────────────────────────────────
// Email change (one pending request per user)
// ─────────────────────────────────────────────────────────────

model EmailChangeRequest {
  id String @id @default(uuid()) @db.Uuid

  // NOT unique: otherwise one user could "reserve" an address and block others.
  // User.email's unique constraint protects user at confirmation time.
  newEmail String @db.VarChar(255)

  tokenHash   String    @unique
  expiresAt   DateTime
  confirmedAt DateTime?

  ipAddress String? @db.VarChar(45)
  userAgent String? @db.VarChar(512)

  userId String @unique @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
}

// ─────────────────────────────────────────────────────────────
// Profile & settings
// ─────────────────────────────────────────────────────────────

model UserProfile {
  id String @id @default(uuid()) @db.Uuid

  displayName String? @db.VarChar(100)
  bio         String? @db.VarChar(500)

  profileType  AppearanceType @default(COLOR)
  profileValue String?        @db.VarChar(2048)

  coverType  AppearanceType @default(COLOR)
  coverValue String?        @db.VarChar(2048)

  userId String @unique @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserSettings {
  id String @id @default(uuid()) @db.Uuid

  darkMode Boolean @default(false)

  userId String @unique @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────
// Accounts (credentials / OAuth identities)
// ─────────────────────────────────────────────────────────────

model Account {
  id String @id @default(uuid()) @db.Uuid

  provider AuthProvider

  // LOCAL: use the user's id. OAuth: the provider's subject id.
  // (Avoid using email for LOCAL so email changes don't need a sync.)
  providerAccountId String @db.VarChar(255)

  // argon2id hash. Only for LOCAL (enforced by CHECK below)
  passwordHash String?

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, providerAccountId])
  @@unique([userId, provider])
  @@index([provider])
}

// ─────────────────────────────────────────────────────────────
// One-time tokens (password reset, email verification)
// ─────────────────────────────────────────────────────────────

model AuthToken {
  id String @id @default(uuid()) @db.Uuid

  tokenHash String        @unique // SHA-256 of a randomBytes(32) token
  type      AuthTokenType

  expiresAt DateTime
  usedAt    DateTime?
  revokedAt DateTime?

  ipAddress String? @db.VarChar(45)
  userAgent String? @db.VarChar(512)

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, type])
  @@index([type, expiresAt]) // cleanup job + lookups
}

// ─────────────────────────────────────────────────────────────
// Refresh tokens (rotation + reuse detection)
// ─────────────────────────────────────────────────────────────

model RefreshToken {
  id String @id @default(uuid()) @db.Uuid

  tokenHash String @unique // never store the raw token

  // All tokens descended from one login share a familyId.
  // If a revoked token is presented again, revoke the whole family.
  familyId     String  @db.Uuid
  replacedById String? @db.Uuid

  expiresAt DateTime
  revokedAt DateTime?

  ipAddress String? @db.VarChar(45)
  userAgent String? @db.VarChar(512)

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
}

// ─────────────────────────────────────────────────────────────
// Audit log (no FK on purpose: keep history after user deletion)
// ─────────────────────────────────────────────────────────────

model AuditLog {
  id String @id @default(uuid()) @db.Uuid

  userId String? @db.Uuid
  event  String  @db.VarChar(64) // e.g. LOGIN_SUCCESS, LOGIN_FAILED, PASSWORD_CHANGED, TOKEN_REUSE

  ipAddress String? @db.VarChar(45)
  userAgent String? @db.VarChar(512)
  metadata  Json?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([event, createdAt])
}
