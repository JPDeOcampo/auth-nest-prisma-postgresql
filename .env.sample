# Copy this file to .env for local development. Replace all placeholders.
# Production must use HTTPS, secure secret-manager values, and distinct random
# JWT access, JWT refresh, and password pepper values (at least 32 characters).
ORIGIN=http://localhost:3000

# Backend server configuration
PORT=5000
BACKEND_URL=http://localhost:5000

# Required in production. Use a private Redis instance with TLS.
# REDIS_URL=rediss://user:password@redis.example.com:6380
# Required in production; use a unique namespace per environment.
# REDIS_PREFIX=auth-api:production:
# Comma-separated proxy IPs/CIDRs that are allowed to set forwarded headers.
# Required in production; never use "*" or trust arbitrary forwarded headers.
# TRUST_PROXY=10.20.0.0/16,192.168.10.0/24

# Database configuration
# Production database URLs must include sslmode=require (or verify-ca/verify-full).
DATABASE_URL=postgresql://postgres:password@localhost:5432/auth?schema=public

# JWT configuration
JWT_ACCESS_SECRET=replace-with-a-distinct-random-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-another-distinct-random-secret-32-characters
PEPPER=replace-with-a-random-password-pepper-at-least-32-characters

# SMTP credentials. Production also requires EMAIL_FROM.
EMAIL_USER=your-smtp-user
EMAIL_PASS=your-smtp-password
EMAIL_FROM=Auth Service <no-reply@example.com>

# Firebase Admin SDK
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-service-account@example.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-with-service-account-key\n-----END PRIVATE KEY-----\n"

NODE_ENV=development